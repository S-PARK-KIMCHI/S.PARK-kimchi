---
import '../styles/global.css';
import brush from '../assets/kimchi-brush.svg?raw';
import logoMark from '../assets/logo-mark.svg?raw';
import logoFull from '../assets/logo-full.svg?raw';
import { brand, contacts, products, facts, pairings, partners } from '../data/site.js';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const u = (p) => base + p;
const title = 'Кимчи S.PARK — корейская острая капуста с доставкой';
const description = 'Кимчи S.PARK по традиционному корейскому рецепту: пекинская капуста с перцем чили, естественная ферментация, без консервантов. Заказ домой и для ресторанов.';
const qf = 'M25 25A25 25 0 0 1 75 25A25 25 0 0 1 75 75A25 25 0 0 1 25 75A25 25 0 0 1 25 25Z';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={u('img/table.webp')} />
  <meta name="theme-color" content="#963a37" />
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
</head>
<body>
  <header class="top">
    <div class="wrap top__in">
      <a class="top__logo" href="#top" aria-label="S.PARK, на главную">
        <span class="top__mark" set:html={logoMark} />
        <span class="top__name">S.PARK</span>
      </a>
      <nav class="top__nav" aria-label="Разделы">
        <a href="#formats">Форматы</a>
        <a href="#with">С чем есть</a>
        <a href="#video">Видео</a>
        <a href="#b2b">Ресторанам</a>
      </nav>
      <a class="top__phone" href={contacts.phoneHref}>{contacts.phone}</a>
      <a class="btn top__cta" href="#order">Заказать</a>
    </div>
  </header>

  <main id="top">
    <!-- ПЕРВЫЙ ЭКРАН -->
    <section class="hero">
      <div class="wrap hero__in">
        <div class="hero__text">
          <div class="hero__brush" aria-hidden="true" set:html={brush} />
          <h1>Кимчи S.PARK — острая капуста по&nbsp;корейскому рецепту</h1>
          <p class="hero__lead">Пекинская капуста с перцем чили, квашенная естественным способом. Без консервантов. Открыли банку — и на стол.</p>
          <div class="hero__actions">
            <a class="btn" href="#order">Заказать кимчи</a>
            <a class="btn btn--ghost" href="#video">Смотреть видео</a>
          </div>
          <p class="hero__note">Принимаем заказы домой, а также для кафе и ресторанов.</p>
        </div>

        <div class="hero__window">
          <svg class="qf-line" viewBox="-2 -2 104 104" aria-hidden="true">
            <path d={qf} fill="none" stroke="currentColor" stroke-width="1.1" vector-effect="non-scaling-stroke" />
          </svg>
          <div class="qf-video">
            <video autoplay muted loop playsinline preload="metadata" poster={u('media/hero-poster.jpg')} aria-label="Нарезка: капуста кимчи, банка S.PARK, подача к столу">
              <source src={u('media/hero-loop.webm')} type="video/webm" />
              <source src={u('media/hero-loop.mp4')} type="video/mp4" />
            </video>
          </div>
          <button class="hero__pause" type="button" aria-pressed="false">Пауза</button>
        </div>
      </div>
    </section>

    <!-- ФОРМАТЫ -->
    <section class="formats" id="formats">
      <div class="wrap">
        <h2 class="h2">Выберите вес</h2>
        <p class="sub">Рецепт один и тот же — капуста кимчи с перцем чили. Отличается только объём.</p>
        <ul class="formats__list">
          {products.map((p) => (
            <li class="product">
              <div class={`product__pic product__pic--${p.shape}`}>
                <img src={u(p.image)} alt={p.imageAlt} width="520" height={p.shape === 'round' ? 520 : 281} loading="lazy" />
              </div>
              <div class="product__body">
                <h3>{p.title}</h3>
                <p class="product__note">{p.note}</p>
                <p class="product__price">{p.price ? `${p.price} ₽` : 'Цену назовём при подтверждении заказа'}</p>
                <div class="stepper" data-id={p.id}>
                  <button type="button" class="stepper__btn" data-step="-1" aria-label={`Убрать ${p.weight}`}>−</button>
                  <output class="stepper__val" data-qty={p.id} aria-live="polite">0</output>
                  <button type="button" class="stepper__btn" data-step="1" aria-label={`Добавить ${p.weight}`}>+</button>
                  <span class="stepper__unit">шт. в заказе</span>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- О ПРОДУКТЕ -->
    <section class="about">
      <div class="wrap about__in">
        <figure class="about__pic">
          <img src={u('img/tearing.webp')} alt="Руки в перчатках разделяют лист капусты кимчи" width="1280" height="720" loading="lazy" />
        </figure>
        <div class="about__text">
          <h2 class="slogan">Острый. Дерзкий. Настоящий.</h2>
          <dl class="facts">
            {facts.map((f) => (
              <div class="facts__row">
                <dt>{f.title}</dt>
                <dd>{f.text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- С ЧЕМ ЕСТЬ -->
    <section class="with" id="with">
      <div class="wrap with__in">
        <div class="with__text">
          <h2 class="h2">С чем есть кимчи</h2>
          <p class="sub">В Корее кимчи стоит на столе почти всегда. Он добавляет блюду остроту и кислинку.</p>
          <ul class="with__list">
            {pairings.map((x) => <li>{x}</li>)}
          </ul>
        </div>
        <figure class="with__pic">
          <img src={u('img/table.webp')} alt="Корейский стол: рис, пибимпап, мясо, закуски и тарелка кимчи" width="1280" height="720" loading="lazy" />
        </figure>
      </div>
    </section>

    <!-- ВИДЕО -->
    <section class="video" id="video">
      <div class="wrap video__in">
        <div class="video__text">
          <h2 class="h2">Знакомьтесь: S.PARK</h2>
          <p>Ли Вадим, коммерческий директор S.PARK, рассказывает о кимчи и показывает, как его подают. Видео 1 мин 18 сек, со звуком.</p>
        </div>
        <div class="video__player">
          <video controls preload="none" playsinline poster={u('media/video-poster.jpg')} width="1280" height="720">
            <source src={u('media/sbak-video.mp4')} type="video/mp4" />
          </video>
        </div>
      </div>
    </section>

    <!-- B2B -->
    <section class="b2b" id="b2b">
      <div class="wrap b2b__in">
        <figure class="b2b__pic">
          <img src={u('img/bowl-hand.webp')} alt="Порция кимчи в белой пиале" width="1280" height="720" loading="lazy" />
        </figure>
        <div class="b2b__text">
          <h2 class="h2">Для кафе и ресторанов</h2>
          <p>Поставляем кимчи заведениям по договору. Уже работаем с {partners.map((p, i) => <>{i > 0 && ' и '}{i === 0 ? p : `«${p}»`}</>)}.</p>
          <ul class="b2b__list">
            <li>Объём и фасовку подбираем под вашу кухню</li>
            <li>Одинаковый вкус от поставки к поставке</li>
            <li>Регулярные поставки по графику</li>
          </ul>
          <a class="btn" href="#order" data-mode="b2b">Оставить заявку для заведения</a>
        </div>
      </div>
    </section>

    <!-- ЗАКАЗ -->
    <section class="order" id="order">
      <div class="wrap order__in">
        <div class="order__intro">
          <h2 class="h2">Оформить заказ</h2>
          <p>Оставьте заявку — мы перезвоним, подтвердим наличие, цену и время доставки.</p>
          <p class="order__call">Или позвоните: <a href={contacts.phoneHref}>{contacts.phone}</a></p>
          <div class="order__mark" aria-hidden="true" set:html={logoMark} />
        </div>

        <form class="form" id="order-form" novalidate data-demo>
          <fieldset class="seg">
            <legend class="visually-hidden">Кому заказ</legend>
            <label><input type="radio" name="mode" value="home" checked /> <span>Домой</span></label>
            <label><input type="radio" name="mode" value="b2b" /> <span>Для заведения</span></label>
          </fieldset>

          <fieldset class="form__items">
            <legend>Что привезти</legend>
            {products.map((p) => (
              <div class="item">
                <span class="item__name">{p.title}</span>
                <div class="stepper stepper--sm" data-id={p.id}>
                  <button type="button" class="stepper__btn" data-step="-1" aria-label={`Убрать ${p.weight}`}>−</button>
                  <output class="stepper__val" data-qty={p.id}>0</output>
                  <button type="button" class="stepper__btn" data-step="1" aria-label={`Добавить ${p.weight}`}>+</button>
                </div>
              </div>
            ))}
            <p class="item__b2b only-b2b">Для заведения можно не выбирать: обсудим объём по телефону.</p>
            <p class="err" data-err="items" hidden>Выберите хотя бы одну позицию.</p>
          </fieldset>

          <div class="form__grid">
            <label class="field only-b2b">
              <span>Название заведения</span>
              <input name="company" autocomplete="organization" />
              <span class="err" data-err="company" hidden>Укажите название заведения.</span>
            </label>
            <label class="field only-b2b">
              <span>Объём в месяц</span>
              <select name="volume">
                <option value="">Пока не знаю</option>
                <option>до 10 кг</option>
                <option>10–50 кг</option>
                <option>больше 50 кг</option>
              </select>
            </label>
            <label class="field">
              <span>Имя</span>
              <input name="name" autocomplete="name" required />
              <span class="err" data-err="name" hidden>Напишите, как к вам обращаться.</span>
            </label>
            <label class="field">
              <span>Телефон</span>
              <input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7" required />
              <span class="err" data-err="phone" hidden>Проверьте номер: нужно 11 цифр.</span>
            </label>
          </div>

          <fieldset class="seg seg--small only-home">
            <legend>Как получить</legend>
            <label><input type="radio" name="delivery" value="courier" checked /> <span>Доставка</span></label>
            <label><input type="radio" name="delivery" value="pickup" /> <span>Самовывоз</span></label>
          </fieldset>

          <label class="field" data-address>
            <span>Адрес доставки</span>
            <input name="address" autocomplete="street-address" placeholder="Город, улица, дом, квартира" />
            <span class="err" data-err="address" hidden>Укажите адрес, куда привезти заказ.</span>
          </label>

          <label class="field">
            <span>Комментарий</span>
            <textarea name="comment" rows="3" placeholder="Удобное время, этаж, пожелания"></textarea>
          </label>

          <label class="check">
            <input type="checkbox" name="consent" required />
            <span>Согласен на обработку персональных данных по <a href="#privacy">политике конфиденциальности</a></span>
          </label>
          <p class="err" data-err="consent" hidden>Нужно согласие, чтобы мы могли вам перезвонить.</p>

          <button class="btn form__submit" type="submit">Отправить заявку</button>
          <p class="form__demo">Пробная версия сайта: заявка пока никуда не отправляется.</p>
        </form>

        <div class="done" id="order-done" hidden tabindex="-1">
          <h3>Заявка принята</h3>
          <p>Это пробная версия: в рабочей заявка сразу придёт менеджеру в Telegram, и он перезвонит.</p>
          <p class="done__sum" id="order-sum"></p>
          <button class="btn btn--ghost" type="button" id="order-again">Оформить ещё одну</button>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot__in">
      <div class="foot__logo" set:html={logoFull} role="img" aria-label="Логотип S.PARK, korean traditions since 1995" />
      <div class="foot__col">
        <p class="foot__h">Связаться</p>
        <a href={contacts.phoneHref}>{contacts.phone}</a>
        {contacts.telegram && <a href={contacts.telegram}>Telegram</a>}
        {contacts.vk && <a href={contacts.vk}>ВКонтакте</a>}
      </div>
      <div class="foot__col">
        <p class="foot__h">Компания</p>
        <p>{contacts.legal}</p>
        <details id="privacy" class="foot__privacy">
          <summary>Политика конфиденциальности</summary>
          <p>Текст политики добавим вместе с реквизитами. Данные из формы заказа используются только для связи с вами по заказу.</p>
        </details>
      </div>
    </div>
  </footer>

  <script>
    const qty = { k250: 0, k1000: 0 };
    const render = () => {
      document.querySelectorAll('[data-qty]').forEach((el) => { el.textContent = String(qty[el.dataset.qty]); });
    };
    document.querySelectorAll('.stepper').forEach((st) => {
      st.addEventListener('click', (e) => {
        const b = e.target.closest('[data-step]');
        if (!b) return;
        const id = st.dataset.id;
        qty[id] = Math.max(0, Math.min(99, qty[id] + Number(b.dataset.step)));
        render();
        if (qty.k250 + qty.k1000 > 0) showErr('items', false);
      });
    });

    // Пауза фонового видео
    const hv = document.querySelector('.hero video');
    const hp = document.querySelector('.hero__pause');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { hv.removeAttribute('autoplay'); hv.pause(); hp.textContent = 'Играть'; hp.setAttribute('aria-pressed', 'true'); }
    hp.addEventListener('click', () => {
      if (hv.paused) { hv.play(); hp.textContent = 'Пауза'; hp.setAttribute('aria-pressed', 'false'); }
      else { hv.pause(); hp.textContent = 'Играть'; hp.setAttribute('aria-pressed', 'true'); }
    });

    // Форма
    const form = document.getElementById('order-form');
    const done = document.getElementById('order-done');
    const addr = form.querySelector('[data-address]');
    const setMode = () => {
      const m = form.mode.value;
      form.dataset.mode = m;
      const courier = m === 'b2b' || form.delivery.value === 'courier';
      addr.hidden = !courier;
      addr.querySelector('span').textContent = m === 'b2b' ? 'Адрес заведения' : 'Адрес доставки';
    };
    form.addEventListener('change', setMode);
    setMode();
    document.querySelectorAll('[data-mode="b2b"]').forEach((a) => a.addEventListener('click', () => {
      form.querySelector('input[name="mode"][value="b2b"]').checked = true; setMode();
    }));

    function showErr(key, on) {
      const el = form.querySelector(`[data-err="${key}"]`);
      if (!el) return;
      el.hidden = !on;
      const input = form.elements[key];
      if (input && input.setAttribute) input.setAttribute('aria-invalid', on ? 'true' : 'false');
    }
    const phone = form.phone;
    const fmt = (v) => {
      const all = v.replace(/\D/g, '');
      let rest = /^[78]/.test(all) ? all.slice(1) : all;
      if (/^[78]/.test(rest) && (rest.length === 1 || rest.length === 11)) rest = rest.slice(1);
      const d = '7' + rest.slice(0, 10);
      const p = [d.slice(1, 4), d.slice(4, 7), d.slice(7, 9), d.slice(9, 11)];
      let out = '+7';
      if (p[0]) out += ' (' + p[0];
      if (p[0].length === 3) out += ')';
      if (p[1]) out += ' ' + p[1];
      if (p[2]) out += '-' + p[2];
      if (p[3]) out += '-' + p[3];
      return out;
    };
    phone.addEventListener('focus', () => { if (!phone.value) phone.value = '+7 '; });
    phone.addEventListener('input', (e) => {
      if (e.inputType && e.inputType.startsWith('delete')) return;
      phone.value = fmt(phone.value);
    });
    phone.addEventListener('blur', () => { if (phone.value.replace(/\D/g, '').length <= 1) phone.value = ''; });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const m = form.mode.value;
      const digits = phone.value.replace(/\D/g, '');
      const checks = {
        items: m === 'home' && qty.k250 + qty.k1000 === 0,
        company: m === 'b2b' && !form.company.value.trim(),
        name: !form.name.value.trim(),
        phone: digits.length !== 11,
        address: !addr.hidden && m === 'home' && !form.address.value.trim(),
        consent: !form.consent.checked,
      };
      let first = null;
      for (const [k, bad] of Object.entries(checks)) {
        showErr(k, bad);
        if (bad && !first) first = k;
      }
      if (first) {
        const target = form.elements[first] || form.querySelector('.form__items');
        (target.focus ? target : form.querySelector('.stepper__btn')).focus();
        return;
      }
      const parts = [];
      if (qty.k250) parts.push(`250 г × ${qty.k250}`);
      if (qty.k1000) parts.push(`1000 г × ${qty.k1000}`);
      document.getElementById('order-sum').textContent =
        (m === 'b2b' ? `Заведение: ${form.company.value.trim()}. ` : '') +
        (parts.length ? `В заказе: ${parts.join('; ')}. ` : '') +
        `Перезвоним по номеру ${phone.value.trim().replace(/-/g, '\u2011').replace(/ /g, '\u00a0')}.`;
      form.hidden = true; done.hidden = false; done.focus();
    });
    document.getElementById('order-again').addEventListener('click', () => {
      form.reset(); qty.k250 = 0; qty.k1000 = 0; render(); setMode();
      done.hidden = true; form.hidden = false; form.name.focus();
    });
  </script>
</body>
</html>

<style is:global>
  /* шапка */
  .top { position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.96); border-bottom: 1px solid var(--line); }
  .top__in { display: flex; align-items: center; gap: 28px; min-height: 72px; }
  .top__logo { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .top__mark { width: 46px; flex: none; }
  .top__name { font-weight: 500; font-size: 1.25rem; letter-spacing: .08em; }
  .top__nav { display: flex; gap: 24px; margin-left: auto; }
  .top__nav a, .top__phone { text-decoration: none; font-size: 1rem; }
  .top__nav a:hover, .top__phone:hover { color: var(--red); }
  .top__phone { font-weight: 500; white-space: nowrap; }
  .top__cta { min-height: 44px; padding: 0 20px; font-size: 1rem; }
  @media (max-width: 960px) { .top__nav { display: none; } .top__phone { margin-left: auto; } }
  @media (max-width: 560px) { .top__phone { display: none; } .top__cta { margin-left: auto; } .top__in { gap: 12px; min-height: 64px; } .top__mark { width: 40px; } }

  /* первый экран */
  main section { scroll-margin-top: 72px; }
  .hero { padding: clamp(32px, 5vw, 72px) 0 clamp(48px, 7vw, 96px); overflow: hidden; }
  .hero__in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .hero__brush { color: var(--ink); width: min(100%, 560px); margin-left: -1.5%; }
  .hero__brush svg { width: 100%; }
  .hero h1 { font-size: var(--fs-3); font-weight: 500; margin-top: 18px; max-width: 18ch; }
  .hero__lead { margin-top: 18px; color: var(--muted); max-width: 44ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .hero__note { margin-top: 18px; font-size: 1rem; color: var(--muted); }

  .hero__window { position: relative; width: 100%; max-width: 580px; aspect-ratio: 1; justify-self: end; color: var(--red); }
  .qf-line { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .qf-line path { stroke-width: 3px; }
  .qf-video {
    position: absolute; inset: 7%;
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' preserveAspectRatio='none'><path d='M25 25A25 25 0 0 1 75 25A25 25 0 0 1 75 75A25 25 0 0 1 25 75A25 25 0 0 1 25 25Z'/></svg>") center / 100% 100% no-repeat;
            mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' preserveAspectRatio='none'><path d='M25 25A25 25 0 0 1 75 25A25 25 0 0 1 75 75A25 25 0 0 1 25 75A25 25 0 0 1 25 25Z'/></svg>") center / 100% 100% no-repeat;
    background: var(--napa);
  }
  .qf-video video { width: 100%; height: 100%; object-fit: cover; }
  .hero__pause {
    position: absolute; right: 0; bottom: 0; border: 1px solid var(--line); background: var(--white);
    border-radius: 999px; padding: 6px 14px; font-size: .875rem; cursor: pointer; color: var(--ink);
  }
  @media (max-width: 820px) {
    .hero__in { grid-template-columns: 1fr; }
    .hero__window { order: -1; justify-self: center; max-width: 440px; }
    .hero__text { display: flex; flex-direction: column; }
    .hero__brush { width: min(100%, 420px); }
  }

  /* общие заголовки */
  .h2 { font-size: var(--fs-4); font-weight: 500; letter-spacing: -.01em; }
  .sub { margin-top: 14px; color: var(--muted); max-width: 52ch; }

  /* форматы */
  .formats { background: var(--napa); padding: clamp(56px, 8vw, 110px) 0; }
